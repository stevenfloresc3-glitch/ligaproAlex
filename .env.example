# Configurar en el entorno local y en Netlify. No guardar valores reales aquí.
DATABASE_URL=

# URL pública de Neon Managed Auth para el cliente Vite (no es la clave de la base)
VITE_NEON_AUTH_URL=

# Solo si este proyecto o rama usa una URL distinta al endpoint por defecto.
# No son credenciales; Netlify Functions las usan para verificar los JWT.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
